# Backend env - Development
NODE_ENV=development
PORT=3001

# Database (SQLite)
DATABASE_URL="file:./dev.db"

# JWT
JWT_ACCESS_SECRET=lupbi_access_secret_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=lupbi_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_DOMAIN=localhost
